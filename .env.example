SERVER_ADDR=:8080

DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=backend

JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ACCESS_TTL=15m
REFRESH_TTL=168h

CORS_ALLOW_ORIGINS=http://localhost:3000

COOKIE_REFRESH_NAME=refresh_token
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax
COOKIE_REFRESH_PATH=/api/auth/refresh

ARGON2_MEMORY_KIB=65536
ARGON2_ITERATIONS=3
ARGON2_THREADS=2

GOOSE_DRIVER=mysql
GOOSE_DBSTRING=root:1234@tcp(127.0.0.1:3306)/backend?charset=utf8mb4&parseTime=True&loc=Local
GOOSE_MIGRATION_DIR=./migration